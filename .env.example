# Server
PORT=3000

# SQLite database file location
DB_PATH=./data/woodhamptons.db

# Admins: comma-separated emails. Edit and restart the service to change them.
ADMIN_EMAILS=ewilmoth@gmail.com
# Shared password every admin email must enter to log in.
ADMIN_PASSWORD=
# Separate password needed to see the cumulative scores while a game is running,
# so admins can't peek. Keep it different from ADMIN_PASSWORD.
SCORES_PASSWORD=

# Where a backup copy of each round's scores (plus the running totals) is
# emailed as the game goes. Leave blank to turn backups off.
BACKUP_EMAIL=edwilmoth@outlook.com

# Gmail SMTP, used for the final results email and the round backups.
# Use a Google App Password, not your normal password:
# https://myaccount.google.com/apppasswords
GMAIL_USER=ewilmoth@gmail.com
GMAIL_APP_PASSWORD=
